# Password untuk masuk ke /admin. Wajib diisi.
ADMIN_PASSWORD=

# Password untuk masuk ke /driver (halaman toggle status "Sedang Mengantar"). Wajib diisi.
DRIVER_PASSWORD=

# Diisi otomatis oleh Vercel setelah Upstash Redis (Storage > Create Database > Upstash)
# dihubungkan ke project. Tidak perlu diisi manual saat development lokal (fallback ke
# file lokal di folder .data/). Nama variable bisa UPSTASH_REDIS_REST_URL/TOKEN atau
# KV_REST_API_URL/TOKEN tergantung versi integrasinya — keduanya didukung otomatis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
