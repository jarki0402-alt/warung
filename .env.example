# Password untuk masuk ke /admin. Wajib diisi.
ADMIN_PASSWORD=

# Password untuk masuk ke /driver (halaman toggle status "Sedang Mengantar"). Wajib diisi.
DRIVER_PASSWORD=

# Diisi otomatis oleh Vercel setelah Upstash Redis (Storage > Create Database > Upstash)
# dihubungkan ke project. Tidak perlu diisi manual saat development lokal (fallback ke
# file lokal di folder .data/). Nama variable bisa UPSTASH_REDIS_REST_URL/TOKEN atau
# KV_REST_API_URL/TOKEN tergantung versi integrasinya — keduanya didukung otomatis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsional — cuma dibutuhkan kalau mau rekap harian "niat checkout" tersinkron
# otomatis ke Google Sheets (lihat PROGRESS.md bagian "Log Checkout"). Kosongkan
# kalau belum mau pakai fitur ini, sisanya tetap jalan normal tanpa ini.
# Link deployment Google Apps Script Web App (lihat panduan setup).
GOOGLE_SHEETS_WEBHOOK_URL=

# String acak bebas (isi sendiri) — dipakai Vercel buat verifikasi bahwa endpoint
# cron sync memang dipanggil oleh Vercel sendiri, bukan orang lain dari luar.
CRON_SECRET=
